{
  "lastChangelogVersion": "1.0.0",
  "theme": "dark",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "medium",
  "enabledModels": [
    "amazon-bedrock/global.anthropic.claude-fable-5-1",
    "amazon-bedrock/global.anthropic.claude-opus-5-5",
    "amazon-bedrock/global.anthropic.claude-sonnet-5-5",
    "amazon-bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0",
    "amazon-bedrock/global.openai.gpt-6-luna",
    "amazon-bedrock/global.openai.gpt-6.1-sol",
    "amazon-bedrock/global.openai.gpt-5.6-terra",
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6.1-sol",
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-6-luna"
  ],
  "packages": [
    "npm:@piotr-oles/pi-reflag",
    "npm:pi-subagents",
    "git:github.com/apmantza/pi-lens",
    "npm:pi-web-access",
    "git:github.com/cli/cli",
    "npm:pi-cost",
    "npm:context-mode",
    "npm:@juicesharp/rpiv-todo",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@plannotator/pi-extension"
  ],
  "subagents": {
    "defaultModel": "openai-codex/gpt-6-luna",
    "defaultThinking": "low",
    "agentOverrides": {
      "scout": {
        "description": "Fast repository reconnaissance and concise context summaries.",
        "model": "openai-codex/gpt-6-luna",
        "thinking": "low"
      },
      "researcher": {
        "description": "Evidence-led external research and source-backed synthesis.",
        "model": "openai-codex/gpt-6.1-sol",
        "thinking": "medium"
      },
      "delegate": {
        "description": "Lightweight, well-scoped delegation, including summaries and routine tasks.",
        "model": "openai-codex/gpt-6-luna",
        "thinking": "low"
      },
      "worker": {
        "description": "Primary implementation agent for approved, well-scoped changes.",
        "model": "amazon-bedrock/global.anthropic.claude-sonnet-5-5",
        "thinking": "medium"
      },
      "reviewer": {
        "description": "Deep, adversarial review for correctness, regressions, and security risks.",
        "model": "amazon-bedrock/global.anthropic.claude-opus-5-5",
        "thinking": "high"
      },
      "oracle": {
        "description": "High-stakes reasoning and decision-consistency advisory review.",
        "model": "openai-codex/gpt-6-astra",
        "thinking": "high"
      }
    }
  }
}
